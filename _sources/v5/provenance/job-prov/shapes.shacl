@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix wfprov: <http://purl.org/wf4ever/wfprov#> .
@prefix wfdesc: <http://purl.org/wf4ever/wfdesc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oap5s: <https://www.opengis.net/def/ogcapi-processes-5/1.0/prov/shapes/> .

oap5s:JobStatusEntityShape a sh:NodeShape ;
    sh:targetSubjectsOf prov:wasInfluencedBy ;
    sh:name "REQ_job-entity" ;
    sh:property [
        sh:path prov:atLocation ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:pattern "^https?://" ;
        sh:message "A job status entity MUST have a prov:location with the absolute job URL." ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue prov:Entity ;
        sh:message "A job status entity MUST be a prov:Entity." ;
    ] ;
    sh:property [
        sh:path prov:wasInfluencedBy ;
        sh:class prov:Activity ;
        sh:message "A job status entity MUST be influenced by the job activity (prov:Activity)." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path dct:conformsTo ;
        sh:minCount 1 ;
        sh:message "A job status entity SHOULD include dct:conformsTo for each profile it conforms to (REC_profile-entities)." ;
    ] .

oap5s:JobStatusRelationShape a sh:NodeShape ;
    sh:targetClass wfprov:WorkflowRun, wfprov:ProcessRun ;
    sh:name "REQ_job-entity relation" ;
    sh:sparql [
        sh:message "A job activity MUST be related to a job status entity through prov:wasInfluencedBy or prov:wasGeneratedBy." ;
        sh:prefixes oap5s: ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    ?status prov:atLocation ?location .
                    ?status prov:wasInfluencedBy|prov:wasGeneratedBy $this .
                }
            }
        """ ;
    ] .

oap5s: sh:declare [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] .

oap5s:ProcessEntityShape a sh:NodeShape ;
    sh:targetClass wfdesc:Process ;
    sh:name "REQ_process-entity" ;
    sh:or (
        [ sh:path prov:atLocation ; sh:minCount 1 ; sh:pattern "^https?://" ]
        [ sh:path rdf:type ; sh:hasValue prov:Plan ]
    ) ;
    sh:message "A process entity (wfdesc:Process) MUST have a prov:location with the absolute process URL." .

oap5s:JobActivityShape a sh:NodeShape ;
    sh:targetClass wfprov:WorkflowRun, wfprov:ProcessRun ;
    sh:name "REQ_job-activity" ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue prov:Activity ;
        sh:message "A job run (wfprov:WorkflowRun or wfprov:ProcessRun) MUST be a prov:Activity." ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path prov:qualifiedAssociation ;
        sh:minCount 1 ;
        sh:message "A job activity SHOULD be associated with the process (plan) and agents." ;
    ] ;
    sh:property [
        sh:path prov:qualifiedUsage ;
        sh:node oap5s:RoleQualificationShape ;
    ] .

oap5s:RoleQualificationShape a sh:NodeShape ;
    sh:name "REQ_input-entity / REQ_result-entity roles" ;
    sh:property [
        sh:path prov:hadRole ;
        sh:minCount 1 ;
        sh:message "Usages and generations of data entities MUST set prov:role to the input or output identifier." ;
    ] .

oap5s:ArtifactShape a sh:NodeShape ;
    sh:targetClass wfprov:Artifact ;
    sh:name "REQ_result-entity" ;
    sh:property [
        sh:path prov:qualifiedGeneration ;
        sh:node oap5s:RoleQualificationShape ;
    ] .

oap5s:ArtifactValueShape a sh:NodeShape ;
    sh:targetClass wfprov:Artifact ;
    sh:name "REC_data-entity" ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:path prov:value ; sh:minCount 1 ]
        [ sh:path prov:atLocation ; sh:minCount 1 ]
        [ sh:path prov:hadMember ; sh:minCount 1 ]
    ) ;
    sh:message "A data entity SHOULD provide prov:value (small data) or prov:location (large data)." .

oap5s:ProfileEntityShape a sh:NodeShape ;
    sh:targetObjectsOf dct:conformsTo ;
    sh:name "REC_profile-entity" ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path prov:role ;
        sh:minCount 1 ;
        sh:message "A profile entity SHOULD set prov:role to the expanded role URI." ;
    ] .
