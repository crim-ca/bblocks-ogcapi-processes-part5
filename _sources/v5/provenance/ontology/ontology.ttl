@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix wfprov: <http://purl.org/wf4ever/wfprov#> .
@prefix wfdesc: <http://purl.org/wf4ever/wfdesc#> .
@prefix wf4ever: <http://purl.org/wf4ever/wf4ever#> .
@prefix oap1: <https://www.opengis.net/def/ogcapi-processes-1/1.0/> .
@prefix oap5: <https://www.opengis.net/def/ogcapi-processes-5/1.0/prov/> .

<https://www.opengis.net/def/ogcapi-processes-5/1.0/prov>
    a owl:Ontology ;
    dct:title "OGC API - Processes - Part 5: Provenance concept mappings"@en ;
    rdfs:comment """Provisional ontology. Relates the Part 1 concepts (process, job, input, result) to the
    PROV Entity, Activity and Agent concepts, as characterized by the Part 5 provenance requirements."""@en .

# Part 1 concepts (no published semantics, anchored here)

oap1:Process a owl:Class ; rdfs:label "Process (Part 1)"@en ;
    rdfs:comment "A process offered by an OGC API - Processes server, described by a process description."@en .
oap1:Job a owl:Class ; rdfs:label "Job (Part 1)"@en ;
    rdfs:comment "The execution of a process."@en .
oap1:JobStatus a owl:Class ; rdfs:label "Job status (Part 1)"@en ;
    rdfs:comment "The status info document reflecting the state of a job."@en .
oap1:Input a owl:Class ; rdfs:label "Input (Part 1)"@en ;
    rdfs:comment "A value or reference submitted to a process execution."@en .
oap1:Output a owl:Class ; rdfs:label "Output / Result (Part 1)"@en ;
    rdfs:comment "A value or reference produced by a process execution."@en .
oap1:Profile a owl:Class ; rdfs:label "Metadata profile (Part 1/2)"@en .

# Part 5 specializations of PROV

oap5:ProcessEntity a owl:Class ;
    rdfs:label "Process entity"@en ;
    rdfs:subClassOf prov:Entity, wfdesc:Process, oap1:Process ;
    skos:definition """PROV Entity profiling the Part 1 process. Its prov:location is the absolute
    process URL (REQ_process-entity). For a workflow, it is the root process."""@en .

oap5:JobStatusEntity a owl:Class ;
    rdfs:label "Job status entity"@en ;
    rdfs:subClassOf prov:Entity, oap1:JobStatus ;
    skos:definition """PROV Entity reflecting the Part 1 job status (statusInfo). It is distinct from the job
    activity that represents the execution. Its prov:location is the absolute job URL (REQ_job-entity).
    It is related to the job activity by prov:wasInfluencedBy or prov:wasGeneratedBy."""@en .

oap5:JobActivity a owl:Class ;
    rdfs:label "Job activity"@en ;
    rdfs:subClassOf prov:Activity, oap1:Job ;
    skos:definition """PROV Activity representing the execution of the job. It is associated with the
    process entity (REQ_job-activity). Typed wfprov:WorkflowRun or wfprov:ProcessRun."""@en .

oap5:InputEntity a owl:Class ;
    rdfs:label "Input entity"@en ;
    rdfs:subClassOf prov:Entity, wfprov:Artifact, oap1:Input ;
    skos:definition "Entity used by the job activity (prov:used), with prov:role set to the inputID."@en .

oap5:ResultEntity a owl:Class ;
    rdfs:label "Result entity"@en ;
    rdfs:subClassOf prov:Entity, wfprov:Artifact, oap1:Output ;
    skos:definition """Entity generated by the job activity (prov:wasGeneratedBy),
    with prov:role set to the outputID."""@en .

oap5:CollectionEntity a owl:Class ;
    rdfs:label "Collection entity"@en ;
    rdfs:subClassOf prov:Collection, wfprov:Artifact ;
    skos:definition "Collection of data entities related through prov:hadMember."@en .

oap5:FileEntity a owl:Class ;
    rdfs:label "File entity"@en ;
    rdfs:subClassOf wf4ever:File, wfprov:Artifact ;
    skos:definition "Data entity holding a file, located by prov:location."@en .

oap5:ProfileEntity a owl:Class ;
    rdfs:label "Profile entity"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition """Metadata profile reported through dct:conformsTo, whose prov:role is the expanded
    role URI. A specialized profile is linked to the generic one by prov:specializationOf."""@en .

oap5:SoftwareAgent a owl:Class ;
    rdfs:label "Server / engine agent"@en ;
    rdfs:subClassOf prov:SoftwareAgent .

oap5:UserAgent a owl:Class ;
    rdfs:label "User agent"@en ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "Person or placeholder agent on whose behalf the job is executed."@en .
